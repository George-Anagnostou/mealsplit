# Copy this file to .env.deploy and adjust. .env.deploy is ignored by git.
# One KEY=value per line: no quotes, no spaces, no `export`. Values already set in your
# shell win over this file.

# SSH target. This can be an ~/.ssh/config alias, such as the "mysite" alias bookmarks uses.
MEALSPLIT_DEPLOY_HOST=mysite

# Optional: only when the alias does not set a user.
# MEALSPLIT_DEPLOY_USER=george

# Directory on the server. Must be owned by the SSH user (one-time setup in docs/DEPLOY.md).
MEALSPLIT_DEPLOY_PATH=/var/www/mealsplit

# Public URL, checked after every deploy and by `make verify`.
MEALSPLIT_URL=https://mealsplit.georgeanagnostou.com

# Optional: how many releases to keep on the server for rollback (default 5, minimum 2).
# MEALSPLIT_KEEP_RELEASES=5
